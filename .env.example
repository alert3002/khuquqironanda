# cp .env.example .env  — пас қимматҳоро пур кунед (файли .env дар git commit НАКУНЕД)

APPLE_BUNDLE_ID=com.bookkhuquqronanda.week

# OsonSMS
OSONSMS_LOGIN=your_login
OSONSMS_HASH=your_sha256_hash_key
OSONSMS_SENDER=1week.tj

# Telegram — BotFather → Login Widget (OIDC)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=huquqironanda_bot
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Бояд ДАҚИҚАН ҳамин бошад, ки дар BotFather → Redirect URIs:
TELEGRAM_OAUTH_REDIRECT_URI=https://books.1week.tj/telegram-login/oauth/callback/
TELEGRAM_APP_CALLBACK_SCHEME=khuquqironanda

# SmartPay Ecommerce API v2 (production: ecomm.smartpay.tj)
SMARTPAY_API_KEY=
SMARTPAY_API_BASE_URL=https://ecomm.smartpay.tj/api/merchant
SMARTPAY_MERCHANT_SITE=Kharid.tj
# Ҳамон X-Api-Token, ки дар SmartPay → Webhooks → Headers
SMARTPAY_WEBHOOK_TOKEN=
SMARTPAY_WEBHOOK_BASE_URL=https://books.1week.tj
SMARTPAY_REQUEST_TIMEOUT=30
